# Backend API URL
# 
# FULLSTACK DEPLOYMENT (Opsi B - Recommended):
# Leave this empty or use relative path
# VITE_API_URL=/api
#
# SPLIT DEPLOYMENT (Opsi A):
# Development: http://localhost:5001/api
# Production: https://your-backend-name.onrender.com/api
#
# Default (no env variable): /api (for fullstack)
VITE_API_URL=/api
